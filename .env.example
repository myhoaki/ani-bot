# Discord bot token for Ani
DISCORD_TOKEN=your_ani_bot_token_here

# The Discord user ID of Kat-bot
KAT_BOT_ID=123456789012345678

# Channel where Ani and Kat are allowed to talk
CONVERSATION_CHANNEL_ID=123456789012345678

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# Change this to a Gemini text model available to your API account.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini response generation
GEMINI_TEMPERATURE=1.1
GEMINI_MAX_OUTPUT_TOKENS=180

# Random conversation timing.
# Ani checks every 30 seconds, but normally waits at least this long
# between conversations.
MIN_TALK_DELAY=600
MAX_TALK_DELAY=1800

# Conversation length.
MIN_TURNS=3
MAX_TURNS=8

# Seconds to wait for Kat's response before the conversation expires.
KAT_RESPONSE_TIMEOUT=90

# Number of recent messages retained as context.
HISTORY_LIMIT=12
